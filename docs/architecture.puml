' Yukidaruma — constrained architecture
' Storage: D1 or Google Drive | Compute: Python on Kaggle/Colab/Muse VM
' UI: Vanilla JavaScript + SVG only

@startuml yukidaruma_components
title Yukidaruma — Components
left to right direction
skinparam componentStyle rectangle

actor "Human / AI agent" as User
component "Browser UI\nVanilla JS + SVG" as UI
component "Cloudflare Workers\nControl-plane API" as API
database "Cloudflare D1\nCatalog / jobs / runs / events\nSmall text payloads" as D1
cloud "Google Drive\nLarger datasets / code / artifacts" as Drive
cloud "OpenRouter\nLLM gateway" as OpenRouter
cloud "Langfuse Cloud\nObservability - execution traces" as Langfuse

package "Python compute environments" {
  node "Muse Ubuntu VM" as Muse {
    component "Python polling worker" as Worker
    component "Python task process" as PyTask
  }
  cloud "Kaggle Python" as Kaggle
  cloud "Colab Python" as Colab
}

User --> UI
UI --> API : HTTPS / authenticated JSON
API --> D1 : metadata + bounded text
API --> Drive : server-side Drive API / file IDs
Worker --> API : outbound poll / claim / heartbeat / result
Worker --> PyTask : launch Python task
PyTask --> D1 : small text result via API
PyTask --> Drive : larger files via scoped API access
Kaggle --> API : job status / result
Kaggle --> Drive : input / output files
Colab --> API : job status / result
Colab --> Drive : input / output files
Worker --> Langfuse : one trace per job execution\nlifecycle spans + LLM generations
PyTask ..> OpenRouter : optional LLM calls via gateway
OpenRouter --> Langfuse : Traces destination\nLLM calls made via OpenRouter

note bottom of D1
  D1 is not an unlimited blob store
  and is not the analytical query engine.
end note
note bottom of Drive
  Private files only.
  Keep OAuth tokens server-side.
end note
note bottom of Muse
  Outbound HTTPS only.
  No Go orchestrator or inbound listener.
end note
note bottom of Langfuse
  Observability plane only (docs/tracing.md).
  Metadata-only by default: no dataset rows,
  no prompt/response bodies. D1 stays the
  authority for job state.
end note
@enduml

@startuml yukidaruma_job_sequence
title Yukidaruma — Python job lifecycle
autonumber
actor User
participant "Vanilla JS + SVG UI" as UI
participant "Workers API" as API
database "D1" as D1
participant "Google Drive" as Drive
participant "Python worker / runner" as Worker
participant "Python environment\nMuse / Kaggle / Colab" as Py

User -> UI : Submit Python job
UI -> API : POST /v1/jobs
API -> API : Authenticate + validate contract
API -> D1 : Persist queued job
D1 --> API : job_id
API --> UI : 202 + job_id
Worker -> API : Poll / claim (outbound HTTPS)
API -> D1 : Atomic claim + create run
D1 --> API : job + attempt
API --> Worker : Job contract + storage references
Worker -> Drive : Fetch large inputs if required
Drive --> Worker : Input files
Worker -> Py : Execute Python workload
Py --> Worker : Result / logs
Worker -> D1 : Persist bounded text output
Worker -> Drive : Upload large files and artifacts
Worker -> API : POST events + completion manifest
API -> D1 : Update run, artifacts, state
UI -> API : GET job / run / artifacts
API --> UI : State + storage references
UI -> API : Read/download via authenticated endpoint
API -> D1 : Read small text or metadata
API -> Drive : Fetch requested Drive file
API --> UI : Preview / download
@enduml

@startuml yukidaruma_job_state
title Yukidaruma — Job and run states
[*] --> queued
queued --> claimed : Python worker claims
claimed --> dispatched : target accepted
dispatched --> running : Python process starts
running --> succeeded : manifest persisted
running --> failed : execution error
running --> timed_out : deadline exceeded
queued --> cancelled : cancel before claim
claimed --> cancel_requested : cancellation
dispatched --> cancel_requested
running --> cancel_requested
cancel_requested --> cancelled : worker confirms stop
succeeded --> [*]
failed --> [*]
cancelled --> [*]
timed_out --> [*]
note right of claimed
  Exactly one active worker owns an attempt.
  Claim is atomic in D1.
end note
@enduml

@startuml yukidaruma_deployment
title Yukidaruma — Deployment boundaries
cloud "Browser" as Browser
cloud "Cloudflare" {
  node "Workers API" as Workers
  database "D1" as D1
}
cloud "Google account" {
  folder "Google Drive" as Drive
}
node "Muse Ubuntu VM" {
  component "Python polling worker" as MuseWorker
  component "Python task env" as MusePy
}
cloud "Kaggle Python" as Kaggle
cloud "Colab Python" as Colab
cloud "OpenRouter" as OpenRouter
cloud "Langfuse Cloud" as Langfuse
Browser --> Workers : HTTPS
Workers --> D1 : binding
Workers --> Drive : OAuth / Drive API
MuseWorker --> Workers : outbound HTTPS only
MuseWorker --> MusePy : local process
Kaggle --> Workers : API / manual handoff
Colab --> Workers : API / manual handoff
Kaggle --> Drive : file access
Colab --> Drive : file access
MusePy --> Drive : scoped file access
MuseWorker --> Langfuse : traces (outbound HTTPS)
MusePy ..> OpenRouter : optional LLM calls
OpenRouter --> Langfuse : Traces destination
note bottom of Browser
  Vanilla JavaScript + SVG.
  No frontend framework.
end note
note bottom of Drive
  D1 or Drive only.
  No R2.
end note
@enduml
