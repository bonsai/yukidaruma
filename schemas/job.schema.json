{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bonsai/yukidaruma/blob/main/schemas/job.schema.json",
  "title": "Yukidaruma Job",
  "description": "Versioned job submission contract. Server-owned fields (job_id, state, timestamps, runner assignment) must not be trusted from clients. Credentials must never appear in job payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task",
    "runtime",
    "input",
    "output"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "description": "Client-generated key to prevent duplicate submissions."
    },
    "task": {
      "type": "string",
      "enum": [
        "python_script",
        "sql_query",
        "notebook",
        "analyze_dataset",
        "transform"
      ],
      "description": "High-level task type."
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "language"
      ],
      "properties": {
        "target": {
          "type": "string",
          "enum": [
            "auto",
            "muse_vm",
            "colab",
            "kaggle"
          ],
          "description": "Python execution target. auto selects among the configured Python environments."
        },
        "language": {
          "type": "string",
          "const": "python"
        },
        "version": {
          "type": "string",
          "description": "Optional language/runtime version pin, e.g. '3.11'."
        }
      }
    },
    "input": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "uri",
          "format"
        ],
        "properties": {
          "dataset_id": {
            "type": "string"
          },
          "uri": {
            "type": "string",
            "description": "Storage reference: d1://dataset-row-id or gdrive://file-id."
          },
          "format": {
            "type": "string",
            "enum": [
              "parquet",
              "csv",
              "jsonl",
              "json",
              "notebook",
              "tar.gz",
              "zip"
            ]
          },
          "version": {
            "type": "string"
          },
          "checksum": {
            "type": "string"
          }
        }
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_uri": {
          "type": "string",
          "description": "D1 or Google Drive reference to Python source/bundle."
        },
        "revision": {
          "type": "string",
          "description": "Git SHA or explicit version string."
        },
        "entrypoint": {
          "type": "string",
          "description": "Entrypoint path inside the bundle, e.g. main.py"
        }
      }
    },
    "parameters": {
      "type": "object",
      "description": "Task-specific parameters. Must not contain secrets."
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gpu": {
          "type": [
            "boolean",
            "string"
          ],
          "description": "true/false or 'optional' / 'required'"
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 256,
          "maximum": 131072
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 86400
        },
        "cpu_cores": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "prefix"
      ],
      "properties": {
        "prefix": {
          "type": "string",
          "description": "D1 dataset/result namespace or Google Drive folder reference.",
          "default": "gdrive://folder-id"
        },
        "backend": {
          "type": "string",
          "enum": [
            "d1",
            "google_drive"
          ]
        }
      }
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "default": 50
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional Langfuse tracing intent (see docs/tracing.md). Submitter preferences only — credentials must never appear here; tracing configuration comes from the runner environment.",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "description": "Workflow/session identifier grouping this job's trace with related jobs' traces. Omit for standalone jobs."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Additional trace tags, merged with the job's top-level tags and the derived task/runtime tags."
        },
        "trace_name": {
          "type": "string",
          "minLength": 1,
          "description": "Override for the root span name. Must follow the naming rules in docs/tracing.md (verb-first, stable, no dynamic values)."
        }
      }
    }
  }
}
