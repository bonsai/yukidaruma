{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bonsai/yukidaruma/blob/main/schemas/job.schema.json",
  "title": "Yukidaruma Job",
  "description": "Versioned job submission contract. Server-owned fields (job_id, state, timestamps, runner assignment) must not be trusted from clients. Credentials must never appear in job payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task", "runtime", "input", "output"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "description": "Client-generated key to prevent duplicate submissions."
    },
    "task": {
      "type": "string",
      "enum": ["python_script", "sql_query", "notebook", "analyze_dataset", "transform"],
      "description": "High-level task type."
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "language"],
      "properties": {
        "target": {
          "type": "string",
          "enum": ["auto", "muse_vm", "colab", "kaggle", "local_duckdb"],
          "description": "Preferred execution target. 'auto' lets the orchestrator choose."
        },
        "language": {
          "type": "string",
          "enum": ["python", "sql", "rust", "go"]
        },
        "version": {
          "type": "string",
          "description": "Optional language/runtime version pin, e.g. '3.11'."
        }
      }
    },
    "input": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uri", "format"],
        "properties": {
          "dataset_id": { "type": "string" },
          "uri": {
            "type": "string",
            "description": "Object store URI, e.g. r2://datasets/example.parquet"
          },
          "format": {
            "type": "string",
            "enum": ["parquet", "csv", "jsonl", "json", "notebook", "tar.gz", "zip"]
          },
          "version": { "type": "string" },
          "checksum": { "type": "string" }
        }
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_uri": {
          "type": "string",
          "description": "URI of code bundle or notebook."
        },
        "revision": {
          "type": "string",
          "description": "Git SHA or explicit version string."
        },
        "entrypoint": {
          "type": "string",
          "description": "Entrypoint path inside the bundle, e.g. main.py"
        }
      }
    },
    "parameters": {
      "type": "object",
      "description": "Task-specific parameters. Must not contain secrets."
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gpu": {
          "type": ["boolean", "string"],
          "description": "true/false or 'optional' / 'required'"
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 256
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 86400
        },
        "cpu_cores": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prefix"],
      "properties": {
        "prefix": {
          "type": "string",
          "description": "R2 (or other object store) prefix for artifacts, e.g. r2://artifacts/job-output/"
        }
      }
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "default": 50
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
